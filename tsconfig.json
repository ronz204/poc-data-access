{
	"include": [
    "cmd/**/*",
    "source/**/*",
    "testing/**/*",
    "drizzle/**/*",
    "**.config.ts",
  ],
	"compilerOptions": {
		// Environment - Latest JavaScript features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",

		// Bundler mode - Modern module resolution for Bun
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Type checking - Strict mode enabled
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,

		// Bun runtime types
		"types": ["@types/bun"],

		// Best practices - Additional safety checks
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,

		// Module resolution - Support for absolute imports
		"paths": {
			"@env": ["./source/env.ts"],

			"@app/*": ["./source/app/*"],
			"@keys/*": ["./source/keys/*"],
			"@core/*": ["./source/core/*"],
			"@infra/*": ["./source/infra/*"],
      "@repos/*": ["./source/repos/*"],

			"@testing/*": ["./testing/*"],

			"@dal/*": ["./drizzle/dal/*"],
			"@db/*": ["./drizzle/database/*"],
		}
	}
}