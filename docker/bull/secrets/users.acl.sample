# Redis users. Copy to users.acl (same folder, never committed) and replace
# each `change-me-*` with a real password, e.g. from `openssl rand -hex 24`.
#
# The password is whatever follows `>`, with no space after it:
#   user bull on >s3cr3t ...   ->  username: bull, password: s3cr3t
#
# Restart the container after editing: docker compose restart pattern-queues

# No anonymous access.
user default off

# BullMQ clients (outbox worker and queue consumer): redis://bull:<password>@127.0.0.1:6379
user bull on >change-me-bull ~* &* +@all -acl -shutdown

# Manual access (any Redis client).
user admin on >change-me-admin ~* &* +@all

# Healthcheck only: it can do nothing but ping.
user probe on nopass -@all +ping
